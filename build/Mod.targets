<Project>
  <!--
    Packaging for anything that ships as a mod folder: <game>/Mods/<ModId>/.
    Copies the build output, mod.json and the assets/ folder.
  -->
  <PropertyGroup>
    <NeetModId Condition="'$(NeetModId)' == ''">$(AssemblyName)</NeetModId>
    <NeetModOutDir>$(NeetModsDir)/$(NeetModId)</NeetModOutDir>
  </PropertyGroup>

  <!-- Framework assemblies are already loaded by the game; never copy them next to a mod. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <Private>false</Private>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <None Include="mod.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('mod.json')" />
    <None Include="assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="NeetDeployMod" AfterTargets="Build" Condition="'$(NeetDeploy)' == 'true'">
    <ItemGroup>
      <_NeetModFile Include="$(OutDir)**/*" Exclude="$(OutDir)**/*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_NeetModFile)"
          DestinationFiles="@(_NeetModFile->'$(NeetModOutDir)/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="$(NeetModId) -> $(NeetModOutDir)" />
  </Target>
</Project>
