<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>neet</AssemblyName>
    <RootNamespace>NeetTool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The loader reference only orders the build; it is never loaded by the tool. -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <!-- The installer ships the loader and Harmony next to itself in payload/. -->
  <ItemGroup>
    <ProjectReference Include="../../src/NeetLoader/NeetLoader.csproj" ReferenceOutputAssembly="false" Private="false" />
    <None Include="../../src/NeetLoader/bin/$(Configuration)/NeetLoader.dll" Link="payload/NeetLoader.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="../../src/NeetLoader/bin/$(Configuration)/NeetLoader.pdb" Link="payload/NeetLoader.pdb" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)lib.harmony/$(HarmonyVersion)/lib/net472/0Harmony.dll" Link="payload/0Harmony.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)mono.cecil/$(CecilVersion)/lib/net40/Mono.Cecil.dll" Link="payload/Mono.Cecil.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
