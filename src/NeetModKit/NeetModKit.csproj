    <RootNamespace>NeetModKit</RootNamespace>
    <Description>Shared framework for NEET Demo mods: game access, content registries, mod menu.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NeetLoader/NeetLoader.csproj" />
  </ItemGroup>

  <!-- Ships as a regular mod folder: <game>/Mods/NeetModKit. -->
