<Project>
  <!-- Settings shared by every project in the repo. -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Authors>pawbeans</Authors>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <!-- The commit a build comes from, in each assembly's informational version. -->
  <Import Project="build/Revision.targets" />

  <!-- Optional per-machine overrides (gitignored). -->
  <Import Project="build/Local.props" Condition="Exists('$(MSBuildThisFileDirectory)build/Local.props')" />

  <!-- Where the game lives. Override with NEET_GAME_DIR or build/Local.props. -->
  <PropertyGroup>
    <NeetGameDir Condition="'$(NeetGameDir)' == '' and '$(NEET_GAME_DIR)' != ''">$(NEET_GAME_DIR)</NeetGameDir>
    <NeetGameDir Condition="'$(NeetGameDir)' == '' and '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\NEET Demo</NeetGameDir>
    <NeetGameDir Condition="'$(NeetGameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/NEET Demo</NeetGameDir>
    <NeetManagedDir>$(NeetGameDir)/NEET_Data/Managed</NeetManagedDir>
    <NeetModsDir>$(NeetGameDir)/Mods</NeetModsDir>
    <!-- Copy builds into the game folder automatically when it exists. -->
    <NeetDeploy Condition="'$(NeetDeploy)' == '' and Exists('$(NeetManagedDir)')">true</NeetDeploy>
    <HarmonyVersion>2.3.6</HarmonyVersion>
    <CecilVersion>0.11.4</CecilVersion>
  </PropertyGroup>
</Project>
