// Calls from the player's past and the outside world: reunions, bills, old jobs, overdue books.
{
  "calls": [
    {
      "id": "past-reunion",
      "name": "Class reunion",
      "callerId": "REUNION",
      "incoming": { "weight": 2, "once": true },
      "say": [
        "Hi, is this the number for the Hollow Creek High class of 2009?",
        "It's Denise. Denise Mott. We sat behind each other in chemistry, you ate paste off my desk, dude.",
        "Anyway it's the reunion. Saturday. The gym. Warm punch, a slideshow, and Doug.",
        "<size=60%>Doug still wears the prom jacket. He smells like the prom.<size=100%>",
        { "choices": [
          {
            "text": "I'll think about it.",
            "say": [
              "That's what you said at graduation, dumbass.",
              "Okay. I'm putting you down as maybe, with a little star.",
              { "do": "flag", "name": "past_reunion_maybe" }
            ]
          },
          {
            "text": "Sure, I'll come.",
            "say": [
              "Holy shit, really? Doug is going to lose his fucking mind.",
              "Saturday, seven o'clock. Wear something that isn't a hoodie with crust on it.",
              { "do": "flag", "name": "past_reunion_yes" }
            ]
          },
          {
            "text": "Fuck off, Denise. No.",
            "say": [
              "Fine. Honestly it's a gym full of people who all peaked at the same dance.",
              { "do": "flag", "name": "past_reunion_no" }
            ]
          }
        ] }
      ]
    },
    {
      "id": "past-reunion-followup",
      "name": "Class reunion",
      "callerId": "REUNION",
      "incoming": {
        "weight": 3,
        "once": true,
        "when": { "all": [ { "flag": "past_reunion_yes" }, { "minutes": ">= 20" } ] }
      },
      "say": [
        "Denise again. You said yes. Saturday came and went, and so did the punch.",
        "Doug sat by the door for three hours. Then he cried in the parking lot. In his car. Dome light on.",
        "<size=150%>SO WHY THE FUCK DIDN'T YOU COME?<size=100%>",
        { "choices": [
          {
            "text": "Nobody told me where it was.",
            "say": [
              "I put it in the group chat. You're not in the group chat. You got kicked out in 2010.",
              "Ugh. Okay. We'll say it was the venue's fault. The venue is always at fault."
            ]
          },
          {
            "text": "I was busy.",
            "say": [
              "Doing what?",
              "...Okay. Okay. Next time, though, you hermit."
            ]
          },
          {
            "text": "I didn't want to.",
            "say": [
              "Honest. I respect that. Doug does not. Doug has been posting about you.",
              { "do": "flag", "name": "past_reunion_followup" }
            ]
          }
        ] }
      ]
    },
    {
