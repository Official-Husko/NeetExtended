// Mom checks in when you're starving. At most every half hour of play.
{
  "id": "mom-food",
  "name": "Mom",
  "callerId": "MOM",
  "incoming": { "weight": 3, "cooldown": 30, "when": { "stat": "Hunger < 25" } },
  "say": [
    "Sweetie? Its mom.",
    "I just had this feeling u havent eaten anything today. Dont lie, I can smell ur room from the stairs.",
    { "choices": [
      {
        "text": "I'm fine, mom.",
        "say": [ "You always say that. U look like a raisin that got sad.", "I ordered u something anyway. Its at the front door. Eat it. Pls.", { "do": "deliver", "item": "Pizza", "after": 20 } ]
      },
      {
        "text": "I'm starving.",
        "say": [ "I KNEW it. I KNEW IT.", "Food is on the way. And theres chicken in the basement freezer, remember? Dont eat it raw.", { "do": "deliver", "item": "Chicken_Nugget_Box", "after": 20 } ]
      }
    ] },
    "Love u. Get yourself sugary snacks, then u dont even need to leave ur room. Shower sometime bb. Its not a suggestion."
  ]
}
