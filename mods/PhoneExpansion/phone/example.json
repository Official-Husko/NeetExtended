// An example call file, and a working test line: dial 555-0100 on either phone.
//
// Every .json and .ink file in a mod's "phone" folder is loaded, and loaded again as soon as it's
// saved. Comments like these are fine. A file holds one call, a list of calls, or { "calls": [...] }.
// The full reference is in docs/modding/phone.md.
{
  "calls": [
    {
      // Unique within this mod. Other calls and conditions can refer to it as "test-line".
      "id": "test-line",
      // What to dial. 3 to 7 digits; the dash is optional.
      "number": "555-0100",
      "name": "Phone Company Test Line",
      // What the phone's screen shows while this call rings (10 characters fit).
      "callerId": "TEST",

      // What's said, top to bottom. Plain text is the caller talking; the game's rich text works.
      "say": [
        "Phone company test line. If u can hear this ur phone works. Congratulation, ur pennis works too.",

        // A line said by the player instead.
        { "player": "Uh, hello?" },

        // Branches on a condition. "then" and "else" take a line or a list of steps.
        {
          "if": { "called": "test-line-callback" },
          "then": "Oh its u again. We called u back remember? Ur phone is fine. Stop calling, dickhead.",
          "else": "U want to test something or u just lonely with ur dick in ur hand?"
        },

        // A place to jump back to with "goto".
        { "label": "menu" },

        // Choices. The chosen text is said by the player, like in the game's own calls.
        {
          "choices": [
            {
              "text": "Test the ringer.",
              "say": [
                "Hang up. We call u back in ten second. Dont go nowhere, not that u ever do. Dont go nowhere with ur dick out.",
                // Actions make things happen. This one rings the call below.
                { "do": "ring", "call": "test-line-callback", "after": 10 },
                // Ends the call right here.
                { "end": true }
              ]
            },
            {
              "text": "Test the lights.",
              "say": [
                "Lights off for five second. <size=60%>dont shit urself",
                { "do": "power", "on": false, "for": 5 }
              ]
            },
            {
              "text": "What's a flag?",
              // Gone once it's been picked.
              "once": true,
              "say": [
                "Is a thing the phone remember even after u save. Now it remember u asked a dumb question.",
                { "do": "flag", "name": "asked_about_flags" },
                { "goto": "menu" }
              ]
            },
            {
              "text": "Got any candy?",
              // Only offered while this holds.
              "if": { "flag": "asked_about_flags" },
              "say": [ "For asking dumb question. Look next to the phone, fatass. Its shaped like a pennis.", { "do": "give", "item": "Candy_Bar" } ]
            },
            { "text": "Bye." }
          ]
        },

        // One of these, picked at random each time.
        { "random": [ "Thank u for testing with us. Goodbye.", "Ur phone is in excellent condition. Ur house smell like a foot and a dick." ] }
      ]
    },
    {
      "id": "test-line-callback",
      "name": "Phone Company",
      "callerId": "TEST",
      // No number: this call only rings in. "manual" means only when something rings it.
      "incoming": { "trigger": "manual" },
      "say": [ "<size=150%>RING RING MOTHERFUCKER", "<size=100%>Is ur callback. Ringer work. Have a spooky night, dickhead." ]
    }
  ]
}
