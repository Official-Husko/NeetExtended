        "Here is 15$ refund. Its cash. Its real cash. Its in an envelope with a dick drawn on it. Dont tell accounting.",
        { "do": "money", "amount": 15 },
        { "choices": [
          {
            "text": "Thanks. Dont do it again.",
            "say": "We will do it again. Its the job."
          },
          {
            "text": "Where is the worm?",
            "say": "Worm is part of the refund. Worm is called Kevin. Kevin is a good boy. Kevin has a pennis like a grape. Kevin is in the garden now."
          }
        ] }
      ]
    },
    {
      "id": "order-mistake",
      "subject": "OOPS sorry",
      "send": { "trigger": "order", "store": "Normal", "delay": 300 },
      "body": [
        "hi this is Warehouse Pete.",
        "we packed ur order wrong. we sent u 1 free Turd.",
        "its not a turd. its a candle shaped like a dick. dont light it. dont look at it. dont ask.",
