        { "do": "deliver", "item": "Turd1", "after": 30 },
        { "choices": [
          {
            "text": "What do I do with a turd?",
            "say": "Its a candle. U wrote candles on the feedback form. We read it. We read all of it."
          },
          {
            "text": "Ok. I light it.",
            "say": "Pete says u lit it. Pete is sorry about ur eyebrows. Pete is not sorry about the smell."
          },
          {
            "text": "Pete you fucking idiot.",
            "say": "Pete is not sorry. Pete is on his break in the walk in freezer with Dave. Dave says ur a dickhead too."
          }
        ] }
      ]
    },
    {
      "id": "railmail-promo",
      "subject": "RAIL MAIL DEALS 4 U ONLY",
      "send": { "trigger": "random", "weight": 2 },
      "body": [
        "Get railed by your mail without fail.",
