// Scam and spam emails for Rail Mail, sequels to the game's own spam. Scammers in broken English,
// a fake password link, a lonely prince, a love scam and the scammer's mom. Some replies cost
// the player money, some pay them back. The follow-ups only come from the replies that send them.
{
  "emails": [
    {
      "id": "spam-prince",
      "subject": "MY ROYAL HIGHNESS NEEDS HELP",
      "send": { "trigger": "arrive", "delay": 60 },
      "body": [
        "<size=150%>HELO FRIEND<size=100%>",
        "I am Prince Dinklebottom the 3rd of the Kingdum of Gravey. My father the King has died. He fell in a vat of gravy and nobody notice for 4 days.",
        "I have 40,000,000$ in a box at the airport. The airport wants 20$ to open the box. Is only fair.",
        "I trust u because u have a computer and the face of a man who is lonely.",
        { "choices": [
          {
            "text": "Here is 20$, prince.",
            "if": { "money": 20 },
            "say": [
              "Thank u friend. Box is open. It has 3 cheese wedges and a note that says sorry.",
              { "do": "money", "amount": -20 },
              { "do": "flag", "name": "spam_prince_paid" },
              { "do": "email", "email": "spam-prince-2", "after": 120 }
            ]
          },
          {
            "text": "I'm a prince too. Pay me 15$.",
            "say": [
              "Oh. Oh no. A fellow royal. Here is 15$ from my royal sock. Pls dont tell the castle.",
              { "do": "money", "amount": 15 }
            ]
          },
          {
            "text": "Is this a scam?",
            "say": "Scam is for poor people. We are royal. Royal people are not allowed to scam, it is in the constitution."
          }
        ] },
        "Yours in gravy,\nPrince Dinklebottom the 3rd (not a scam)"
      ]
    },
    {
      "id": "spam-prince-2",
      "subject": "RE: THE BOX (URGENT)",
      "body": [
        "Prince here again. The airport man say the box has a bad smell.",
        "He open it and say the box is full of cat shit. I say that is ROYAL cat shit, is very expensive.",
        { "choices": [
          {
            "text": "Ok, here is 20$ more.",
            "if": { "money": 20 },
            "say": [
              "Thank u. Ur loyalty is noted in the royal diary. I send u a box also, it is a free box.",
              { "do": "money", "amount": -20 },
              { "do": "deliver", "item": "Cardboard_Box", "after": 30 }
            ]
          },
          {
            "text": "Lol no.",
            "say": [
              "<size=150%>THEN THE KING IS STILL DEAD<size=100%>",
              "The gravy is 6 days old now. The whole kingdum know. Bye bye.",
              { "do": "flag", "name": "spam_prince_lost_box" }
            ]
          }
        ] }
      ]
    },
    {
